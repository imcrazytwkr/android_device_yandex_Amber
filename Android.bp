soong_namespace {
    imports: [
        "vendor/yandex/Amber",
    ],
}

install_symlink {
    name: "firmware_wlan_mac.bin_symlink",
    vendor: true,
    installed_location: "firmware/wlan/qca_cld/wlan_mac.bin",
    symlink_target: "/mnt/vendor/persist/wlan_mac.bin",
}

install_symlink {
    name: "firmware_WCNSS_qcom_cfg.ini_symlink",
    vendor: true,
    installed_location: "firmware/wlan/qca_cld/WCNSS_qcom_cfg.ini",
    symlink_target: "/vendor/etc/wifi/WCNSS_qcom_cfg.ini",
}

// 32-bit libdpmframework.so opens /system/product/etc/dpm/dpm.conf and that
// string has no spare bytes. The library itself cannot stay in product because
// it links libbinder, so both copies are installed in system_ext. The 64-bit
// copy already opens /system/system_ext/etc/dpm/dpm.conf.
install_symlink {
    name: "dpm.conf_symlink",
    product_specific: true,
    installed_location: "etc/dpm/dpm.conf",
    symlink_target: "/system/system_ext/etc/dpm/dpm.conf",
}
